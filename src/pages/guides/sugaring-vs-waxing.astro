---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MobileStickyCta from '../../components/MobileStickyCta.astro';
import { ACQUISITION_MAILTO, SITE } from '../../config/site';
import Icon from '../../components/Icon.astro';

const title = 'Sugaring vs Waxing: Which Wins for Brazilian Services? | SugarBrazilianWax.com';
const description =
  'Compare sugaring and traditional Brazilian waxing — comfort, skin impact, cleanup, and why SugarBrazilianWax.com is built for the natural alternative.';

const breadcrumbs = [
  { name: 'Home', url: `${SITE.url}/` },
  { name: 'Guides', url: `${SITE.url}/guides/` },
  { name: 'Sugaring vs Waxing', url: `${SITE.url}/guides/sugaring-vs-waxing/` },
];
---

<BaseLayout {title} {description} type="article" {breadcrumbs}>
  <Nav />
  <main class="bg-cream">
    <article class="max-w-3xl mx-auto px-6 py-14 sm:py-20">
      <nav class="text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/" class="hover:text-rose">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/guides/" class="hover:text-rose">Guides</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-700">Sugaring vs Waxing</li>
        </ol>
      </nav>

      <p class="section-label">COMPARISON GUIDE</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">
        Sugaring vs Traditional Brazilian Waxing
      </h1>
      <p class="mt-5 text-lg text-gray-600 leading-relaxed">
        Clients comparing sugar Brazilian wax to standard waxing want comfort, fewer chemicals, and smoother results.
        Brands that own that story — and the matching domain — win trust faster.
      </p>

      <div class="mt-10 overflow-x-auto rounded-3xl border border-border bg-white">
        <table class="w-full min-w-[32rem] text-left text-sm">
          <thead class="bg-cream-dark text-gray-700">
            <tr>
              <th class="px-4 py-3 font-semibold">Factor</th>
              <th class="px-4 py-3 font-semibold">Sugaring</th>
              <th class="px-4 py-3 font-semibold">Traditional wax</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border text-gray-700">
            <tr>
              <td class="px-4 py-3 font-medium">Temperature</td>
              <td class="px-4 py-3">Near body temperature</td>
              <td class="px-4 py-3">Often hotter application</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Ingredients</td>
              <td class="px-4 py-3">Sugar, lemon, water</td>
              <td class="px-4 py-3">Resins, additives vary</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Skin feel</td>
              <td class="px-4 py-3">Often gentler / less sticky residue</td>
              <td class="px-4 py-3">Can feel harsher on sensitive skin</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Cleanup</td>
              <td class="px-4 py-3">Water-soluble</td>
              <td class="px-4 py-3">Oils/removers often needed</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium">Marketing angle</td>
              <td class="px-4 py-3">Natural / clean beauty</td>
              <td class="px-4 py-3">Familiar mainstream service</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-10 space-y-6 text-gray-700 leading-relaxed">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Why specialists brand around sugaring</h2>
        <p>
          Positioning as a Brazilian sugar wax specialist differentiates you from every generic waxing menu. The
          phrase itself communicates method and service level — which is why {SITE.domain} is category-defining.
        </p>
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900">SEO implication</h2>
        <p>
          Content and branding that consistently use “Brazilian sugar waxing” and “sugar Brazilian wax” help search
          engines and customers understand your niche. Pair that messaging with an exact-match domain for maximum
          clarity.
        </p>
      </div>

      <div class="mt-12 rounded-3xl border border-border bg-white p-6 sm:p-8 text-center">
        <p class="text-sm uppercase tracking-[2px] text-rose font-semibold">Acquire the brand URL</p>
        <p class="mt-2 text-2xl font-semibold tracking-tight">{SITE.name}</p>
        <a
          href="/#acquire"
          class="mt-6 inline-flex items-center gap-2 btn-primary px-8 py-3 rounded-3xl font-semibold min-h-12"
        >
          Make an Offer
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
        <p class="mt-4 text-sm text-gray-500">
          Questions? <a class="text-rose hover:underline" href={ACQUISITION_MAILTO}>{SITE.email}</a>
        </p>
      </div>

      <p class="mt-8 text-sm text-gray-500">
        Related:
        <a href="/guides/brazilian-sugar-waxing/" class="text-rose hover:underline">Brazilian sugar waxing guide</a>
      </p>
    </article>
  </main>
  <Footer />
  <MobileStickyCta />
</BaseLayout>
