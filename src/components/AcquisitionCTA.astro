---
import { ACQUISITION_MAILTO, DOMAIN_OFFER, SITE } from '../config/site';
import Icon from './Icon.astro';
import InquiryForm from './InquiryForm.astro';

const askingPrice = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: DOMAIN_OFFER.priceCurrency,
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
}).format(Number(DOMAIN_OFFER.price));
---

<section id="acquire" class="max-w-screen-xl mx-auto px-6 py-20">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-10">
      <div class="section-label">SEO-SUPERIOR PREMIUM DOMAIN</div>
      <h2 class="text-4xl md:text-5xl tracking-tighter font-semibold mt-3">
        Own the most searchable name in Brazilian sugar waxing.
      </h2>
      <p class="mt-4 text-gray-600 max-w-md mx-auto">
        {SITE.domain} is a high-value, keyword-rich asset. Serious inquiries only — we respond promptly to qualified
        buyers.
      </p>
    </div>

    <div class="bg-white border border-border rounded-3xl p-6 sm:p-9 md:p-12">
      <div class="text-center mb-8">
        <div class="mx-auto w-14 h-14 bg-cream rounded-2xl flex items-center justify-center mb-6">
          <Icon name="handshake" class="w-8 h-8 text-rose" />
        </div>

        <p class="text-sm uppercase tracking-[2px] text-gray-500 font-semibold">Asking price</p>
        <p class="mt-2 text-4xl md:text-5xl font-semibold tracking-tight text-rose-dark">{askingPrice}</p>
        <p class="mt-2 text-sm text-gray-500">USD · Offers considered · Escrow available</p>
      </div>

      <InquiryForm />

      <div class="mt-8 pt-6 border-t border-border text-center">
        <p class="text-sm text-gray-500 mb-3">Prefer email only?</p>
        <a
          href={ACQUISITION_MAILTO}
          class="inline-flex items-center justify-center gap-x-2 text-rose font-semibold hover:underline"
        >
          Make an Offer via Email
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>

<div class="bg-rose-dark py-14 text-white">
  <div class="max-w-screen-xl mx-auto px-6 text-center">
    <h3 class="text-3xl md:text-4xl tracking-tighter font-semibold">
      The window to own {SITE.domain} is open — but it won't stay that way.
    </h3>
    <p class="mt-3 max-w-md mx-auto text-white/90">
      Premium keyword-rich domains in growing beauty categories are acquired quickly by those who recognize their
      long-term value.
    </p>

    <a
      href="#acquire"
      class="mt-8 inline-flex items-center gap-x-3 px-10 py-4 bg-white text-rose-dark font-semibold rounded-3xl text-base hover:bg-gray-100 transition-colors min-h-12"
    >
      Start the Conversation
      <Icon name="arrow-right" class="w-5 h-5" />
    </a>
  </div>
</div>
