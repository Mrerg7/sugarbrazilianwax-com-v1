---
import '../styles/global.css';
import { SITE, OG_IMAGE, ACQUISITION_MAILTO, DOMAIN_OFFER } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  faq?: { question: string; answer: string }[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  noindex = false,
  type = 'website',
  breadcrumbs,
  faq,
} = Astro.props;

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(noindex ? '/' : pathname, SITE.url);
const publishedDate = '2026-07-07';
const modifiedDate = '2026-09-27';

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: 'en-US',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonicalURL.href}#webpage`,
    url: canonicalURL.href,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    datePublished: publishedDate,
    dateModified: modifiedDate,
    inLanguage: 'en-US',
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: OG_IMAGE,
    },
  },
  {
    '@type': 'Product',
    '@id': `${SITE.url}/#product`,
    name: `${SITE.name} Premium Domain Name`,
    description:
      'Premium exact-match .com domain for the natural sugaring and Brazilian wax industry. Available for acquisition.',
    url: SITE.url,
    image: OG_IMAGE,
    category: 'Premium Domain Name',
    brand: {
      '@type': 'Brand',
      name: SITE.name,
    },
    offers: {
      '@type': 'Offer',
      url: `${SITE.url}/#acquire`,
      price: DOMAIN_OFFER.price,
      priceCurrency: DOMAIN_OFFER.priceCurrency,
      priceValidUntil: DOMAIN_OFFER.priceValidUntil,
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      seller: {
        '@type': 'Organization',
        name: 'Desert Rich',
        email: SITE.email,
      },
    },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: 'Desert Rich',
    url: SITE.url,
    email: SITE.email,
  },
];

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: crumb.url,
    })),
  });
}

if (faq?.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalURL.href}#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6B3540" />
    <meta name="format-detection" content="telephone=no" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${SITE.name} — Premium Domain for Natural Sugaring & Brazilian Wax`}
    />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content={`${SITE.name} — Premium Domain for Natural Sugaring & Brazilian Wax`}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style is:inline>
      body {
        margin: 0;
        background: #fdf8f4;
        color: #1f2937;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
    </style>
    {SITE.googleSiteVerification && (
      <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="pb-20 md:pb-0">
    <slot />
    <a
      href={ACQUISITION_MAILTO}
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2"
    >
      Skip to acquisition inquiry
    </a>
  </body>
</html>
